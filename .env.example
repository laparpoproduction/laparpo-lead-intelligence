# Public Supabase project values. The publishable/anon key is safe for browser use.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Server-only. Explicit non-production preview opt-in; forbidden in production.
LAPARPO_DEMO_MODE=false

# Optional server-only Company intelligence configuration. The CRM remains
# available when the key is absent. Never prefix either with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# Server-only. Use at least 32 random characters to sign duplicate confirmations.
COMPANY_DUPLICATE_CONFIRMATION_SECRET=
CONTACT_DUPLICATE_CONFIRMATION_SECRET=
LEAD_DUPLICATE_CONFIRMATION_SECRET=

# Server-only. Must match the value provisioned through a privileged procedure
# into the private database verifier store. Use at least 32 random characters.
MUTATION_AUDIT_CORRELATION_SECRET=

# Optional server-side logging threshold: debug, info, warn, or error.
LOG_LEVEL=info
