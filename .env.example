# Public Supabase project values. The publishable/anon key is safe for browser use.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Server-only. Explicit non-production preview opt-in; forbidden in production.
LAPARPO_DEMO_MODE=false

# Optional server-only AI Phase 1A/1B configuration. The CRM remains available
# when AI is disabled. Enabling requires independent identity and observability
# secrets of at least 32 UTF-8 bytes. Never prefix these with NEXT_PUBLIC_.
AI_FEATURES_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
AI_IDENTITY_HMAC_SECRET=
AI_OBSERVABILITY_HMAC_SECRET=

# Server-only. Use at least 32 random characters to sign duplicate confirmations.
COMPANY_DUPLICATE_CONFIRMATION_SECRET=
CONTACT_DUPLICATE_CONFIRMATION_SECRET=
LEAD_DUPLICATE_CONFIRMATION_SECRET=

# Server-only. Must match the value provisioned through a privileged procedure
# into the private database verifier store. Use at least 32 random characters.
MUTATION_AUDIT_CORRELATION_SECRET=

# TEST-010 only. These server-only flags are production-forbidden and may be
# enabled together only against the disposable authenticated E2E stack.
LAPARPO_AUTHENTICATED_E2E=false
LAPARPO_E2E_AI_STUB=false
LAPARPO_E2E_AI_STUB_CALLS_FILE=

# Optional server-side logging threshold: debug, info, warn, or error.
LOG_LEVEL=info
